{
  "version": "INQSI-BOUNDED-MLB-ENGINEERING-PLANNER-v1",
  "max_changed_files": 6,
  "max_file_bytes": 120000,
  "max_open_agent_prs": 3,
  "allowed_prefixes": [
    "mlb_research/",
    "hello_world/mlb_",
    "tests/unit/test_mlb_",
    "docs/ks1/",
    "engineering_agent/"
  ],
  "forbidden_exact_paths": [
    "template.yaml",
    "bedrock-agent-template.yaml",
    ".github/workflows/deploy.yml",
    ".github/workflows/deploy-bedrock-agent.yml"
  ],
  "forbidden_path_fragments": [
    "/secrets/",
    "credentials",
    ".env",
    "iam",
    "billing",
    "payment"
  ],
  "required_negative_authority_receipts": [
    "no_direct_production_deploy",
    "no_main_branch_write",
    "no_model_promotion",
    "no_secret_mutation",
    "no_other_sport_change"
  ]
}
