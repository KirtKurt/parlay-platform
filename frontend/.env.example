# Live market board / predictions API (server-side preferred).
INQSI_API_URL=https://your-api-gateway-url/Prod
API_URL=https://your-api-gateway-url/Prod

# Browser-visible fallbacks used by the frontend snapshot client.
NEXT_PUBLIC_INQSI_API_URL=https://your-api-gateway-url/Prod
NEXT_PUBLIC_INQSI_API_BASE_URL=https://your-api-gateway-url/Prod
NEXT_PUBLIC_API_BASE_URL=https://your-api-gateway-url/Prod

# Isolated ARB service. Opportunities proxy uses this first.
INQSI_ARB_API_URL=https://your-arb-api-gateway-url/Prod

# Public site identity.
NEXT_PUBLIC_SITE_URL=https://inqsi.app

# Vercel Edge Config connection string. Flags only — never Odds keys.
# Keys: arb_live, board_live, calc_enabled, blocked_regions
EDGE_CONFIG=
