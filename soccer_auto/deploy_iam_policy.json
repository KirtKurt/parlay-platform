{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SoccerAutoQueueLifecycleOnly",
      "Effect": "Allow",
      "Action": [
        "sqs:CreateQueue",
        "sqs:DeleteQueue",
        "sqs:GetQueueAttributes",
        "sqs:GetQueueUrl",
        "sqs:SetQueueAttributes",
        "sqs:TagQueue",
        "sqs:UntagQueue",
        "sqs:ListQueueTags"
      ],
      "Resource": [
        "arn:aws:sqs:us-east-1:735707987003:parlay-platform-soccer-auto-SoccerCollectionQueue-*",
        "arn:aws:sqs:us-east-1:735707987003:parlay-platform-soccer-auto-SoccerCollectionDeadLetterQueue-*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "SoccerAutoAlarmTopicLifecycleOnly",
      "Effect": "Allow",
      "Action": [
        "sns:CreateTopic",
        "sns:DeleteTopic",
        "sns:GetTopicAttributes",
        "sns:SetTopicAttributes",
        "sns:ListSubscriptionsByTopic",
        "sns:TagResource",
        "sns:UntagResource",
        "sns:ListTagsForResource"
      ],
      "Resource": "arn:aws:sns:us-east-1:735707987003:parlay-platform-soccer-auto-SoccerAutoAlarmTopic-*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "SoccerAutoDashboardLifecycleOnly",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutDashboard",
        "cloudwatch:GetDashboard",
        "cloudwatch:DeleteDashboards"
      ],
      "Resource": "arn:aws:cloudwatch::735707987003:dashboard/SoccerAutoDashboard-*"
    }
  ]
}
