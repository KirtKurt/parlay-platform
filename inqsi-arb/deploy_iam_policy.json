{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ArbOpportunityTopicLifecycleOnly",
      "Effect": "Allow",
      "Action": [
        "sns:CreateTopic",
        "sns:DeleteTopic",
        "sns:GetTopicAttributes",
        "sns:SetTopicAttributes",
        "sns:ListSubscriptionsByTopic",
        "sns:TagResource",
        "sns:UntagResource",
        "sns:ListTagsForResource",
        "sns:Subscribe",
        "sns:Unsubscribe",
        "sns:GetSubscriptionAttributes",
        "sns:SetSubscriptionAttributes",
        "sns:Publish"
      ],
      "Resource": "arn:aws:sns:*:*:inqsi-arb-prod-ArbOpportunityTopic-*"
    }
  ]
}
